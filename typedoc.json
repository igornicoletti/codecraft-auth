{
  "entryPointStrategy": "expand",
  "entryPoints": [
    "./src/modules",
    "./src/routes"
  ],
  "out": "docs",
  "name": "CodeCraft Auth API Docs",
  "includeVersion": true,
  "exclude": [
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/node_modules/**",
    "**/ui/**"
  ],
  "cleanOutputDir": true,
  "validation": {
    "notExported": false
  }
}
